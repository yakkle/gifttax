CERT_DOMAIN=example.duckdns.org
LETSENCRYPT_DIR=/etc/letsencrypt

# 후기·관리자 저장소의 자동 정리 간격 (초, 최소 60)
GIFTTAX_RETENTION_INTERVAL_SECONDS=86400

# 관리자 인증: 아래 필수 설정이 없으면 관리자 API 접근을 차단합니다.
# Origin은 실제 HTTPS 주소, RP ID는 포트를 제외한 동일 호스트 이름입니다.
GIFTTAX_ADMIN_MODE=webauthn
GIFTTAX_ADMIN_ORIGIN=https://example.duckdns.org
GIFTTAX_ADMIN_RP_ID=example.duckdns.org
# secrets.token_urlsafe(48) 등으로 생성한 무작위 비밀을 배포 환경에 설정하세요.
GIFTTAX_ADMIN_JWT_SECRET=
